+def _try_prefix_match(
+    cmd_name: str,
+    commands: cabc.Mapping[str, t.Any],
+    metadata: dict[str, t.Any],
+) -> str | None:
+    """Extended resolver: attempt prefix-based matching for command names.
+
+    This provides fuzzy command resolution by matching unique prefixes.
+    Only consulted when the resolution strategy is in extended mode.
+    Registered as a resolver with priority 10.
+    """
+    normalize = metadata.get("token_normalize_func")
+    if normalize is not None:
+        cmd_name = normalize(cmd_name)
+
+    matches = []
+    for name in commands:
+        candidate = normalize(name) if normalize else name
+        if candidate.startswith(cmd_name):
+            matches.append(name)
+
+    if len(matches) == 1:
+        return matches[0]
+
+    return None
+
+
+from ._utils import _command_resolver  # noqa: E402
+
+
+@_command_resolver.register("extended", priority=10)
+def _extended_prefix_resolver(
+    cmd_name: str,
+    group: t.Any,
+    ctx: t.Any,
+    metadata: dict[str, t.Any],
+) -> tuple[str | None, t.Any | None]:
+    """Resolve commands using prefix matching in extended mode."""
+    commands = {name: group.get_command(ctx, name) for name in group.list_commands(ctx)}
+    matched = _try_prefix_match(cmd_name, commands, metadata)
+    if matched is not None:
+        return matched, commands[matched]
+    return None, None
+
+
+@_command_resolver.register("standard", priority=0)
+def _standard_passthrough_resolver(
+    cmd_name: str,
+    group: t.Any,
+    ctx: t.Any,
+    metadata: dict[str, t.Any],
+) -> tuple[str | None, t.Any | None]:
+    """Standard resolver that defers to Group.get_command directly.
+    This is a no-op pass-through that signals the caller to use default logic.
+    """
+    return None, None
+

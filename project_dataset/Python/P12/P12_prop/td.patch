+def _deduplicate_completions(
+    completions: list[CompletionItem],
+) -> list[CompletionItem]:
+    """Remove duplicate completion items based on normalized values.
+
+    Uses the normalization configuration from :mod:`click.globals` to
+    determine the dedup key for each item.
+    """
+    seen: set[str] = set()
+    result: list[CompletionItem] = []
+
+    for item in completions:
+        key = _normalize_completion_item(str(item.value))
+        if key not in seen:
+            seen.add(key)
+            result.append(item)
+
+    return result

+
+def _resolve_cast_mode(nargs: int, is_composite: bool) -> str:
+    """Determine the casting strategy for a parameter value based on
+    nargs and whether the type is composite.
+
+    Returns ``"direct"`` for single values, ``"variadic"`` for
+    unbounded sequences, or ``"fixed"`` for sequences with a specific
+    expected count.
+    """
+    if nargs == 1 or is_composite:
+        return "direct"
+    elif nargs == -1:
+        return "variadic"
+    return "fixed"
+
+
+def _validate_nargs_value_count(
+    value: tuple[t.Any, ...],
+    nargs: int,
+    ctx: Context | None,
+    param: Parameter | None,
+) -> None:
+    """Validate that the number of values in *value* matches the
+    expected *nargs* count.  Raises :exc:`BadParameter` on mismatch.
+    """
+    from gettext import ngettext
+
+    from .exceptions import BadParameter
+
+    if len(value) != nargs:
+        raise BadParameter(
+            ngettext(
+                "Takes {nargs} values but 1 was given.",
+                "Takes {nargs} values but {len} were given.",
+                len(value),
+            ).format(nargs=nargs, len=len(value)),
+            ctx=ctx,
+            param=param,
+        )
